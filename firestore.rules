rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)) ||
        (resource != null && resource.data.ownerId == request.auth.uid)
      );
    }

    function isFamilyAdmin(familyId) {
      return isSignedIn() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)).data.role in ['owner', 'admin']) ||
        (getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid)
      );
    }

    function isFamilyOwner(familyId) {
      return isSignedIn() && (
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // ==========================================
    // 1. Users collection: /users/{userId}
    // ==========================================
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // ==========================================
    // 2. Families collection: /families/{familyId}
    // ==========================================
    match /families/{familyId} {
      // Members or owner can read
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid))
      );

      // Enumeration of families is strictly forbidden
      allow list: if false;

      // Creation of first family:
      // Must be authenticated, set as ownerId, valid name, and atomically create the owner access record
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        existsAfter(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/families/$(familyId)/access/$(request.auth.uid)).data.role == 'owner';

      // Update: only owner or admin, and ownerId cannot be changed
      allow update: if isSignedIn() &&
        isFamilyAdmin(familyId) &&
        request.resource.data.ownerId == resource.data.ownerId;

      // Delete: only family owner
      allow delete: if isSignedIn() && isFamilyOwner(familyId);

      // ==========================================
      // 3. Family Access: /families/{familyId}/access/{userId}
      // ==========================================
      match /access/{userId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isFamilyMember(familyId));
        allow list: if isSignedIn() && isFamilyMember(familyId);

        // Create:
        // Case 1: Initial bootstrap when creating the family in the same batch.
        // Requires: caller creates their own record, role is owner, caller is family owner in getAfter, and family didn't preexist.
        // Case 2: Invitation by existing family admin/owner for non-owner role.
        allow create: if isSignedIn() && (
          (
            request.auth.uid == userId &&
            request.resource.data.role == 'owner' &&
            getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid &&
            !exists(/databases/$(database)/documents/families/$(familyId))
          ) ||
          (
            isFamilyAdmin(familyId) &&
            request.resource.data.role in ['admin', 'member', 'viewer']
          )
        );

        // Update: only owner can update roles; prevent self-promotion
        allow update: if isSignedIn() && isFamilyOwner(familyId) && (
          // Cannot strip the primary owner of their ownership unless transfer
          !(resource.data.role == 'owner' && request.resource.data.role != 'owner')
        );

        // Delete: owner can remove members, or member can leave voluntarily (unless last owner)
        allow delete: if isSignedIn() && (
          isFamilyOwner(familyId) ||
          (request.auth.uid == userId && resource.data.role != 'owner')
        );
      }

      // ==========================================
      // 4. Family Members: /families/{familyId}/members/{memberId}
      // ==========================================
      match /members/{memberId} {
        allow get, list: if isSignedIn() && isFamilyMember(familyId);

        // Create:
        // Case 1: Bootstrap member profile in atomic batch when creating first family.
        // Case 2: Family admin/owner adding a member.
        allow create: if isSignedIn() && (
          (
            request.resource.data.userId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid &&
            !exists(/databases/$(database)/documents/families/$(familyId))
          ) ||
          isFamilyAdmin(familyId)
        );

        allow update: if isSignedIn() && (
          isFamilyAdmin(familyId) ||
          (resource.data.userId == request.auth.uid)
        );

        allow delete: if isSignedIn() && isFamilyAdmin(familyId);
      }

      // ==========================================
      // 5. Family Events: /families/{familyId}/events/{eventId}
      // ==========================================
      match /events/{eventId} {
        allow get, list: if isSignedIn() && isFamilyMember(familyId);
        allow create: if isSignedIn() && isFamilyMember(familyId) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0;
        allow update: if isSignedIn() && isFamilyMember(familyId);
        allow delete: if isSignedIn() && isFamilyMember(familyId);
      }

      // ==========================================
      // 6. Family Memory: /families/{familyId}/memory/{memoryId}
      // ==========================================
      match /memory/{memoryId} {
        allow get, list: if isSignedIn() && isFamilyMember(familyId);
        allow create: if isSignedIn() && isFamilyMember(familyId);
        allow update: if isSignedIn() && isFamilyMember(familyId);
        allow delete: if isSignedIn() && isFamilyAdmin(familyId);
      }
    }
  }
}
